# Copy to .env (git-ignored) and fill in. Only needed for mode = "shadow" or "live".
# Keep this file private: chmod 600 .env  (macOS/Linux)

# Signer key: the wallet that signs orders. Use a dedicated key holding nothing else if you can.
POLY_PRIVATE_KEY=
# Polymarket account wallet that holds the pUSD (profile menu on polymarket.com). Optional for type 0 (EOA).
POLY_FUNDER_ADDRESS=
# 0 = EOA, 1 = proxy wallet (email/Magic login), 2 = Safe (browser wallet), 3 = deposit wallet (accounts since May 2026)
POLY_SIGNATURE_TYPE=1

# Optional: claim winnings automatically without gas (proxy/Safe/deposit wallets).
# polymarket.com → Settings → API Keys → Relayer API Keys: copy the API Key and the Signer Address.
POLY_RELAYER_API_KEY=
POLY_RELAYER_API_KEY_ADDRESS=
